# ============================================================
# Template konfigurasi Alibaba Cloud Model Studio (Token Plan)
# Region: Singapore (ap-southeast-1)
#
# Dipakai oleh day04_inference/api_client.py. Tanpa key, semua eksperimen
# lokal tetap berjalan; hanya bagian panggilan API yang dilewati.
#
# Salin file ini jadi `.env` lalu isi API key Anda:
#   copy .env.example .env        (Windows CMD)
#   cp .env.example .env          (Git Bash / WSL)
# File `.env` sudah di-ignore oleh .gitignore.
# ============================================================

DASHSCOPE_API_KEY=

ALIBABA_CLOUD_REGION=ap-southeast-1
DASHSCOPE_REGION=singapore

# Token Plan memakai endpoint per-workspace, BUKAN dashscope-intl biasa.
# Ganti "token-plan" dengan workspace ID Anda (lihat console Model Studio).
# Format: https://{workspace_id}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1

# Model yang tersedia di Token Plan: qwen3.8-flash, qwen3.8-max,
# deepseek-v4.1-flash, deepseek-v4-pro, glm-5.3, auto, ...
# "qwen-plus" / "qwen-max" adalah nama DashScope publik, tidak ada di sini.
#
# Catatan reasoning model (deepseek-v4.1-*, qwen3.8-max):
# proses berpikir dikirim di reasoning_content dan ikut dihitung sebagai
# completion token. Kalau max_tokens terlalu kecil, seluruh budget habis untuk
# reasoning dan jawaban final bisa kosong (finish_reason="length").
DASHSCOPE_MODEL=deepseek-v4.1-flash-1017
DASHSCOPE_CHAT_MODEL=deepseek-v4.1-flash-1017
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

OPENAI_API_KEY=${DASHSCOPE_API_KEY}
OPENAI_BASE_URL=${DASHSCOPE_BASE_URL}